{{- $items := slice -}}
{{- range site.RegularPages -}}
  {{- $summary := .Params.summary | default .Summary -}}
  {{- $items = $items | append (dict "title" .Title "url" .RelPermalink "section" .Section "date" (.Date.Format "2006-01-02") "summary" $summary "content" .Plain) -}}
{{- end -}}
{{- range where site.Sections "Section" "in" (slice "notes" "labs" "cases" "tech-map") -}}
  {{- $summary := .Params.summary | default .Summary -}}
  {{- $items = $items | append (dict "title" .Title "url" .RelPermalink "section" .Section "date" (.Date.Format "2006-01-02") "summary" $summary "content" .Plain) -}}
{{- end -}}
{{- $items | jsonify -}}
